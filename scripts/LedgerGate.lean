import Lean
import VbmLlmProofs.Ledger
/-! Ledger gate: renders `docs/proof-ledger.md` from `VbmLlmProofs/Ledger.lean`, checks that every named theorem exists and is a theorem, checks every spec-clause tag against `docs/clause-index.txt`
(an unknown tag fails), and REPORTS the counts (proved, open, covered) in the rendered ledger: no baseline gates them. `--selftest` also proves the gate can fail: a tag that is not in the index and a claim that names a non-theorem are each rejected.

"Proved" here means proved about the decoders and arithmetic of the library (the closure gate of the project these gates were first built in, which also asks that a cited theorem be about code the exports run,
is not ported yet: the claims name theorems about the functions that are the library). Exit 1 on regression. -/
open Lean

def readLines (p : String) : IO (List String) := do
  if !(← System.FilePath.pathExists p) then return []
  return (← IO.FS.readFile p).splitOn "\n" |>.map String.trimAscii |>.map (·.toString) |>.filter (fun l => l != "" && !l.startsWith "#")

/-- The clause index: `(convention:clause-id, disposition)` for every line. -/
def parseIndex (ls : List String) : List (String × String) :=
  ls.filterMap fun l => match l.splitOn " " with
    | conv :: id :: disp :: _ => some (s!"{conv}:{id}", disp)
    | _ => none

def tagsOf (o : Obligation) : List String := o.clauses

/-- Tags in the ledger that are not in the index. -/
def unknownTags (idx : List (String × String)) (l : List Obligation) : List String :=
  (l.flatMap tagsOf).filter (fun t => !(idx.any (·.1 == t)))

def isCovering (o : Obligation) : Bool :=
  match o.status with | .proved _ => true | .partly _ _ => true | _ => false

/-- The number of read or policy clauses of the index that a proved or partial claim tags, and the number of such clauses. -/
def coverage (idx : List (String × String)) (l : List Obligation) : Nat × Nat :=
  let want := idx.filter (fun p => p.2 == "read" || p.2 == "policy")
  let covered := want.filter (fun p => l.any (fun o => isCovering o && o.clauses.contains p.1))
  (covered.length, want.length)

def main (args : List String) : IO UInt32 := do
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `VbmLlmProofs.Ledger }] {}
  let arg (k : String) (d : String) : String := match args.dropWhile (· != k) with | _ :: v :: _ => v | _ => d
  let idx := parseIndex (← readLines (arg "--index" "docs/clause-index.txt"))
  if idx.length < 8 then IO.eprintln "ledger: the clause index is missing or too small to be a gate"; return 1
  let mut bad := 0
  let theoremsOk (o : Obligation) : List String :=
    (match o.status with | .proved l => l | .partly l _ => l | _ => []).filterMap fun n =>
      match env.find? n with | some (.thmInfo _) => none | _ => some s!"ledger: {o.slug} names {n}, which is not a theorem"
  for o in ledger do
    for e in theoremsOk o do IO.eprintln e; bad := bad + 1
  for t in unknownTags idx ledger do IO.eprintln s!"ledger: the clause tag {t} is not in docs/clause-index.txt"; bad := bad + 1
  let (covered, wanted) := coverage idx ledger
  let mut proved := 0; let mut part := 0; let mut openN := 0; let mut lim := 0
  let mut rows : Array String := #[]
  let tagText (o : Obligation) : String := if o.clauses.isEmpty then "-" else ", ".intercalate (o.clauses.map (s!"`{·}`"))
  let thmList (l : List Name) : String := ", ".intercalate (l.map fun n => s!"`{n}`")
  for o in ledger do
    match o.status with
    | .proved l => proved := proved + 1; rows := rows.push s!"| `{o.slug}` | **proved** | {tagText o} | {thmList l} |"
    | .partly l n => part := part + 1; rows := rows.push s!"| `{o.slug}` | partial | {tagText o} | {thmList l}; open: {n} |"
    | .open_ n => openN := openN + 1; rows := rows.push s!"| `{o.slug}` | open | {tagText o} | {n} |"
    | .limit n => lim := lim + 1; rows := rows.push s!"| `{o.slug}` | limit | {tagText o} | {n} |"
  let total := ledger.length
  let uncovered := (idx.filter (fun p => (p.2 == "read" || p.2 == "policy") && !(ledger.any (fun o => isCovering o && o.clauses.contains p.1)))).map (·.1)
  let md := "# Obligation ledger\n\nGenerated by `scripts/LedgerGate.lean` from `VbmLlmProofs/Ledger.lean` and `docs/clause-index.txt`; do not edit.\n" ++
    s!"\n**{proved} proved, {part} partial, {openN} open, {lim} limit, of {total}.** Only `proved` may be called verified. A `limit` is a claim no machine decides.\n\n" ++
    s!"**Spec-clause coverage: {covered} of {wanted} clauses** (read or policy clauses of the pinned conventions, `docs/clause-index.txt`) are tagged by a proved or partial claim. " ++
    "Coverage is evidence of traceability from clause to theorem, never of fidelity of the statement (that is a `limit` below).\n\n" ++
    (if uncovered.isEmpty then "" else s!"Clauses with no covering claim: {", ".intercalate (uncovered.map (s!"`{·}`"))}.\n\n") ++
    "| claim (slug) | status | spec clauses | theorems, and what is still open |\n|---|---|---|---|\n" ++ "\n".intercalate rows.toList ++ "\n"
  if !(args.contains "--baseline") && bad == 0 then IO.FS.writeFile "docs/proof-ledger.md" md
  IO.println s!"ledger: {proved} proved, {part} partial, {openN} open, {lim} limit, of {total}"
  IO.println s!"ledger: spec-clause coverage {covered} of {wanted}"
  -- `--selftest`: the gate can fail, in this same process
  if args.contains "--selftest" && bad == 0 then
    if (unknownTags idx (ledger ++ [O "selftest" ["openai-chat:No.Such.Clause"] (.open_ "x")])).isEmpty then IO.eprintln "tier1: the ledger gate cannot fail (a clause tag that is not in the index)"; return 1
    if (theoremsOk (O "selftest" [] (.proved [`Nat.add_comm, `Nat.add]))).isEmpty then IO.eprintln "tier1: the ledger gate cannot fail (a named constant that is not a theorem)"; return 1
    if (theoremsOk (O "selftest" [] (.proved [`No.Such.Theorem]))).isEmpty then IO.eprintln "tier1: the ledger gate cannot fail (a named theorem that does not exist)"; return 1
    IO.println "ledger gate: negative self-tests ok (an unknown clause tag, a non-theorem and a missing theorem are rejected)"
  return if bad == 0 then 0 else 1
